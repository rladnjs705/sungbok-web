# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/sungbok_church
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5

# JWT Configuration
# IMPORTANT: Generate a secure random string at least 32 characters long
# Example: openssl rand -base64 48
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-characters-long-change-this-in-production
JWT_EXPIRATION=3600000  # 1 hour in milliseconds (production)

# Server Configuration
SERVER_PORT=8080

# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_ID=your_youtube_channel_id
YOUTUBE_SYNC_ENABLED=true
YOUTUBE_QUOTA_DAILY_LIMIT=10000
YOUTUBE_QUOTA_WARNING=8000

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://www.sungbok-church.com,https://sungbok-church.com

# Spring Profile
SPRING_PROFILES_ACTIVE=dev  # Use 'prod' for production

# Production Deployment (Optional)
# LOG_PATH=/var/log/sungbok-church
# JAVA_OPTS=-Xms512m -Xmx2048m -XX:+UseG1GC
